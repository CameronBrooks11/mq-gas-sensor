  "repository": {
    "type": "git",
    "url": "https://github.com/CameronBrooks11/mq-gas-sensor.git"
  },
  "homepage": "https://cameronbrooks11.github.io/mq-gas-sensor/",
  "authors": [
    { "name": "Cameron K. Brooks", "maintainer": true },
    { "name": "Miguel Califa" },
    { "name": "Yersson Carrillo" },
    { "name": "Ghiordy Contreras" }
  ],
  "license": "MIT",
  "frameworks": "arduino",
  "platforms": ["atmelavr", "espressif32", "espressif8266"],
  "headers": "MQGasSensor.h",
  "export": {
    "exclude": [
      ".github",
      "analysis",
      "datasheets",
      "docs",
      "scripts",
      "site",
      "tests",
      "mkdocs.yml",
      "justfile",
      "examples/UnitTesting"
    ]
  }
}
